# Copy this file to .env and fill in your values.
# Get a free NVIDIA NIM API key at https://build.nvidia.com
# (sign in -> open any chat model, e.g. Llama 3.1 8B Instruct -> "Get API Key")

NVIDIA_API_KEY=your-nvidia-api-key-here

# Optional — defaults to meta/llama-3.1-8b-instruct if unset.
# Browse other free models at https://build.nvidia.com/models
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional — vision model used for the "upload your bill" feature.
# Defaults to meta/llama-3.2-11b-vision-instruct if unset.
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional — used to sign Flask session cookies. Set a real random value in production.
SECRET_KEY=solarsense-dev-secret-2024

# WhatsApp notifications (sent to Anit Pandey whenever a new lead registers).
# Uses CallMeBot — a free personal WhatsApp notification API. Setup:
#   1. Save +34 644 59 71 65 as a contact on Anit Pandey's phone
#   2. From that phone, send it a WhatsApp message: "I allow callmebot to send me messages"
#   3. CallMeBot replies with a personal apikey (a number) — put it below
# CALLMEBOT_PHONE is the number to notify, digits only, country code, no + or spaces.
CALLMEBOT_PHONE=918005004777
CALLMEBOT_API_KEY=your-callmebot-apikey-here

PORT=8000
